---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../lib/site";
import { otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
    // Path of this page in the other language. Without it, the switch goes to the other home.
    altPath?: string;
    pageTitle?: string;
    description?: string;
    type?: "website" | "article";
}

const { lang, altPath, pageTitle, type = "website" } = Astro.props;
const t = useTranslations(lang);
const description = Astro.props.description ?? t("site.description");

const title = pageTitle ? `${pageTitle} · ${site.name}` : `${site.name} · ${t("site.role")}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(site.photo, Astro.site);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href={site.photo} />
        <link rel="canonical" href={canonicalURL} />
        {altPath && <link rel="alternate" hreflang={otherLang(lang)} href={new URL(altPath, Astro.site)} />}
        <link rel="alternate" type="application/rss+xml" title={site.name} href={lang === "es" ? "/rss.xml" : "/en/rss.xml"} />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />

        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta name="twitter:card" content="summary" />

        <script
            is:inline
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="871cec29-806f-4a76-806b-8cf2b57fef21"
            data-domains="costanzo.blog"
        ></script>

        <script is:inline>
            const stored = localStorage.getItem("theme");
            const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.dataset.theme = dark ? "dark" : "light";
        </script>
    </head>
    <body class="min-h-screen flex flex-col">
        <Header lang={lang} altPath={altPath} />
        <main class="flex-1 w-full max-w-2xl mx-auto px-5 sm:px-6 py-12 sm:py-16">
            <slot />
        </main>
        <Footer lang={lang} />
    </body>
</html>
