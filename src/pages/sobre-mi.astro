---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site } from "../lib/site";

const experience = [
    {
        company: "Renuo",
        url: "https://www.renuo.ch",
        role: "Full-Stack Engineer",
        period: "2025 — hoy",
        place: "Zúrich",
        summary:
            "Lidero un equipo de tres personas en Portal, una plataforma para la Universidad de Berna que crea y gestiona entornos seguros de investigación: máquinas virtuales, identidad y acceso desde el navegador. Diseñé la importación cifrada de datos sensibles con HashiCorp Vault y envelope encryption, e integré Apache Guacamole con FreeIPA para entrar a las VMs sin claves SSH.",
        stack: ["Rails", "PostgreSQL", "OpenStack", "FreeIPA", "Keycloak", "Vault"],
    },
    {
        company: "Unagi",
        url: "https://unagisoftware.com",
        role: "Full-Stack Engineer · Tech lead",
        period: "2022 — 2025",
        place: "Remoto",
        summary:
            "Tech lead en proyectos para clientes de Estados Unidos, Singapur, Chile y Argentina. Actualicé Rails a la última versión y llevé la cobertura de tests al 95% en un SaaS de coaching. Construí la sincronización de inventario de más de 2 millones de hoteles con workflows asíncronos idempotentes. Diseñé un módulo de inversiones para una fintech.",
        stack: ["Rails", "Sidekiq", "PostgreSQL"],
    },
    {
        company: "Smart One",
        role: "Full-Stack Developer",
        period: "2020 — 2022",
        place: "Colombia · Remoto",
        summary:
            "Servicios de matching entre conductores y pasajeros y del ciclo de vida de los viajes para una plataforma de transporte. También un botón de pánico con geolocalización en tiempo real hacia un panel de control.",
        stack: ["Rails", "Real-time"],
    },
];

const linkClass = "underline underline-offset-4 decoration-border hover:text-accent hover:decoration-accent";
---

<Layout pageTitle="Sobre mí">
    <div class="flex items-center gap-6">
        <img
            src={site.photo}
            alt="Bruno Costanzo"
            width="96"
            height="96"
            class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border border-border"
        />
        <div>
            <h1 class="font-serif text-4xl font-semibold tracking-tight">Sobre mí</h1>
            <p class="mt-1 text-muted">{site.role} · Ruby on Rails · Zúrich</p>
        </div>
    </div>

    <div class="prose prose-lg max-w-none mt-10">
        <p>
            Soy Bruno Costanzo. Hace más de seis años que construyo y mantengo aplicaciones Ruby on Rails en
            producción, para clientes de Europa, Estados Unidos y Latinoamérica. Me gusta hacerme cargo del ciclo
            completo: entender el problema, definir la arquitectura, escribir el código y mantenerlo funcionando.
        </p>
        <p>
            Llegué a la programación desde el periodismo. Estudié periodismo político y entre 2017 y 2021 trabajé
            como redactor y subeditor en <a href="https://www.elcanciller.com">elCanciller</a>, como corresponsal en
            Casa Rosada para <a href="https://www.noticiasargentinas.com">Noticias Argentinas</a> y como productor
            de radio. En ese tiempo empecé a programar por curiosidad. En 2021 ahorré para tres meses, renuncié y me
            dediqué solo a aprender. Diez días después tenía dos ofertas de trabajo.
        </p>
        <p>
            Del periodismo me quedó la costumbre de escribir claro y de hacer preguntas hasta entender el problema.
            Por eso tengo este blog, y por eso también doy <em>office hours</em> a desarrolladores autodidactas de
            Argentina que están tomando decisiones técnicas o de carrera.
        </p>
        <p>
            Hablo español, inglés e italiano, y aprendo alemán despacio. Soy hincha de Boca.
        </p>
    </div>

    <section class="mt-16">
        <SectionHeading title="Experiencia" href={site.cv} linkLabel="CV completo (PDF)" />
        <ol class="divide-y divide-border border-y border-border">
            {
                experience.map((job) => (
                    <li class="py-6">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                            <h3 class="font-serif text-xl font-medium">
                                {job.url ? <a href={job.url} class={linkClass}>{job.company}</a> : job.company}
                            </h3>
                            <span class="text-sm text-muted tabular-nums">{job.period}</span>
                        </div>
                        <p class="mt-0.5 text-sm text-muted">
                            {job.role} · {job.place}
                        </p>
                        <p class="mt-3 leading-relaxed">{job.summary}</p>
                        <p class="mt-3 font-mono text-xs text-muted">{job.stack.join(" · ")}</p>
                    </li>
                ))
            }
        </ol>
    </section>

    <section class="mt-16">
        <SectionHeading title="Contacto" />
        <p class="text-lg leading-relaxed">
            Si querés hablar de un proyecto, una posición o algo que escribí, mandame un email a
            <a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a>.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm">
            <a href={site.cv} class="inline-flex items-center gap-2 rounded-full border border-border px-4 py-2 hover:border-text transition-colors">
                <Icon name="lucide:file-text" class="w-4 h-4" /> CV (PDF, en inglés)
            </a>
            <a href={site.github} class="inline-flex items-center gap-2 rounded-full border border-border px-4 py-2 hover:border-text transition-colors">
                <Icon name="lucide:github" class="w-4 h-4" /> GitHub
            </a>
            <a href={site.linkedin} class="inline-flex items-center gap-2 rounded-full border border-border px-4 py-2 hover:border-text transition-colors">
                <Icon name="lucide:linkedin" class="w-4 h-4" /> LinkedIn
            </a>
        </div>
    </section>
</Layout>
