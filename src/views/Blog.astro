---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import { getPosts, groupBy } from "../lib/content";
import { localizePath, otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const years = groupBy(await getPosts(lang), (post) => post.data.pubDate.getFullYear());
---

<Layout lang={lang} altPath={localizePath("/blog", otherLang(lang))} pageTitle={t("blog.title")} description={t("blog.intro")}>
    <h1 class="font-serif text-4xl font-semibold tracking-tight">{t("blog.title")}</h1>
    <p class="mt-3 text-lg text-muted">{t("blog.intro")}</p>

    {
        [...years].map(([year, posts]) => (
            <section class="mt-14">
                <h2 class="mb-4 text-xs font-medium uppercase tracking-[0.14em] text-muted">{year}</h2>
                <PostList lang={lang} posts={posts} />
            </section>
        ))
    }
</Layout>
