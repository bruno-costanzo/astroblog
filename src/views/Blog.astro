---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import { getPosts, groupBy } from "../lib/content";
import { alternates, localizePath, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const years = groupBy(await getPosts(lang), (post) => post.data.pubDate.getFullYear());
---

<Layout lang={lang} alternates={alternates("/blog")} pageTitle={t("blog.title")} description={t("blog.intro")}>
    <h1 data-reveal class="title-rule font-serif text-5xl font-semibold tracking-tight">{t("blog.title")}</h1>
    <p data-reveal style="--delay: 80ms" class="mt-6 text-lg text-muted">{t("blog.intro")}</p>

    {
        [...years].map(([year, posts]) => (
            <section class="mt-14">
                <h2 data-reveal class="mb-4 font-serif text-2xl font-semibold text-sky">{year}</h2>
                <PostList lang={lang} posts={posts} />
            </section>
        ))
    }
</Layout>
