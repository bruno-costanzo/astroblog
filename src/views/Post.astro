---
import { render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { formatDate, getTranslation, postLang, postUrl, readingMinutes } from "../lib/content";
import { site } from "../lib/site";
import { localizePath, useTranslations } from "../i18n";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const lang = postLang(post);
const t = useTranslations(lang);
const translation = await getTranslation(post);
const { Content } = await render(post);
const { title, description, pubDate, tags } = post.data;
---

<Layout lang={lang} altPath={translation && postUrl(translation)} pageTitle={title} description={description} type="article">
    <article>
        <header class="mb-10">
            <p class="text-sm text-muted">
                <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang, "long")}</time>
                <span class="mx-1.5">·</span>
                {readingMinutes(post.body)} {t("post.minutes")}
            </p>
            <h1 class="mt-3 font-serif text-3xl sm:text-[2.6rem] font-semibold tracking-tight leading-[1.15]">{title}</h1>
            <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>
        </header>

        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>

        <footer class="mt-14 pt-8 border-t border-border">
            <div class="flex flex-wrap gap-2">
                {
                    tags.map((tag) => (
                        <a href={localizePath(`/tags/${tag}`, lang)} class="rounded-full border border-border px-3 py-1 text-sm text-muted hover:text-text hover:border-text transition-colors">
                            #{tag}
                        </a>
                    ))
                }
            </div>

            <a href={localizePath("/sobre-mi", lang)} class="group mt-10 flex items-center gap-4">
                <img src={site.photo} alt="" width="56" height="56" class="w-14 h-14 rounded-full object-cover border border-border" />
                <div>
                    <p class="font-medium group-hover:text-accent transition-colors">{site.name}</p>
                    <p class="text-sm text-muted">{t("site.role")} · Zürich</p>
                </div>
            </a>
        </footer>
    </article>
</Layout>
