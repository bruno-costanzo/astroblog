---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactLinks from "../components/ContactLinks.astro";
import IdeaBox from "../components/IdeaBox.astro";
import Polaroid from "../components/Polaroid.astro";
import { site } from "../lib/site";
import { localizePath, otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
    es: {
        lead: "Soy argentino, vivo en Zúrich y hago software desde 2020. Antes fui periodista.",
        story: [
            "Estudié periodismo político en TEA, en Buenos Aires. Trabajé en elCanciller y en Noticias Argentinas hasta 2021.",
            "En esos años aprendí a programar por mi cuenta. Mi primer trabajo como desarrollador fue en 2020, en Smart One: una plataforma para pedir viajes, con un botón de pánico que mandaba la ubicación del chofer en tiempo real.",
            "Después trabajé para clientes de Estados Unidos, Singapur, Chile y Argentina. A veces armé sistemas desde cero. Otras veces me tocó agarrar un sistema que ya existía, ponerlo al día y dejarlo andando mejor.",
            "Hoy estoy en Renuo, en Zúrich. Trabajo en una plataforma para la Universidad de Berna, para que los investigadores trabajen con datos sensibles de forma segura.",
            "Del periodismo me quedaron dos costumbres: hacer muchas preguntas y explicar las cosas simple. Las uso cada vez que alguien me cuenta qué necesita.",
        ],
        alsoTitle: "Además",
        also: [
            { title: "Mentorías", body: "Doy mentorías a desarrolladores argentinos que aprenden solos, sobre decisiones técnicas y de carrera." },
            { title: "Código abierto", body: "Mantengo Fripa, una gem de Ruby que se usa en producción. También mando arreglos a Rails y a otras gems." },
            { title: "Idiomas", body: "Español, inglés e italiano." },
        ],
        workTitle: "Dónde trabajé",
        work: [
            { company: "Renuo", url: "https://www.renuo.ch", place: "Zúrich", years: "2025 – hoy", body: "Una plataforma para la Universidad de Berna. Les da a investigadores máquinas virtuales seguras y acceso desde el navegador." },
            { company: "Unagi", url: "https://unagisoftware.com", place: "Remoto", years: "2022 – 2025", body: "Consultora. Trabajé para varios clientes:" , items: [
                "Sayge, Estados Unidos: actualicé un sistema viejo a la última versión de Rails y subí los tests al 95\u00a0% del código.",
                "Blackbook Travels, Singapur: un módulo que mantiene al día más de 2 millones de hoteles de varios proveedores.",
                "Patrimore, Chile: un módulo para invertir con metas.",
                "Doff, Argentina: un sistema desde cero para pedir licencias y vacaciones.",
            ] },
            { company: "Smart One", place: "Colombia", years: "2020 – 2022", body: "Una plataforma para pedir viajes, con un botón de pánico y la ubicación del chofer en tiempo real." },
            { company: "elCanciller y Noticias Argentinas", place: "Buenos Aires", years: "2017 – 2021", body: "Periodista." },
        ],
    },
    en: {
        lead: "I'm Argentine, I live in Zürich and I have built software since 2020. Before that I was a journalist.",
        story: [
            "I studied political journalism at TEA, in Buenos Aires. I worked at elCanciller and Noticias Argentinas until 2021.",
            "In those years I taught myself to program. My first developer job was in 2020, at Smart One: a ride-hailing platform, with a panic button that sent the driver's location in real time.",
            "After that I worked for clients in the United States, Singapore, Chile and Argentina. Sometimes I built systems from scratch. Other times I took over a system that already existed, brought it up to date and left it working better.",
            "Today I'm at Renuo, in Zürich. I work on a platform for the University of Bern, so researchers can work with sensitive data safely.",
            "Journalism left me two habits: asking a lot of questions and explaining things simply. I use them every time someone tells me what they need.",
        ],
        alsoTitle: "Also",
        also: [
            { title: "Mentoring", body: "I mentor self-taught Argentine developers on technical and career decisions." },
            { title: "Open source", body: "I maintain Fripa, a Ruby gem used in production. I also send fixes to Rails and other gems." },
            { title: "Languages", body: "Spanish, English and Italian." },
        ],
        workTitle: "Where I've worked",
        work: [
            { company: "Renuo", url: "https://www.renuo.ch", place: "Zürich", years: "2025 – now", body: "A platform for the University of Bern. It gives researchers secure virtual machines and access from the browser." },
            { company: "Unagi", url: "https://unagisoftware.com", place: "Remote", years: "2022 – 2025", body: "A consultancy. I worked for several clients:", items: [
                "Sayge, United States: upgraded an old system to the latest Rails version and raised test coverage to 95%.",
                "Blackbook Travels, Singapore: a module that keeps more than 2 million hotels from several providers up to date.",
                "Patrimore, Chile: a goal-based investment module.",
                "Doff, Argentina: a system built from scratch to request leave and time off.",
            ] },
            { company: "Smart One", place: "Colombia", years: "2020 – 2022", body: "A ride-hailing platform, with a panic button and the driver's location in real time." },
            { company: "elCanciller and Noticias Argentinas", place: "Buenos Aires", years: "2017 – 2021", body: "Journalist." },
        ],
    },
}[lang];

const linkClass = "underline underline-offset-4 decoration-border hover:text-accent hover:decoration-accent";
---

<Layout lang={lang} altPath={localizePath("/sobre-mi", otherLang(lang))} pageTitle={t("about.title")}>
    <div class="flex flex-col-reverse gap-10 sm:flex-row sm:items-center sm:justify-between">
        <div data-reveal>
            <h1 class="font-serif text-5xl font-semibold tracking-tight">{t("about.title")}</h1>
            <p class="mt-5 max-w-md font-hand text-2xl sm:text-[1.7rem] italic leading-snug text-accent">{copy.lead}</p>
        </div>
        <div data-reveal="zoom" style="--delay: 150ms" class="w-44 shrink-0 self-center sm:mr-4 sm:w-52">
            <Polaroid caption={lang === "es" ? "Bruno, en Zúrich" : "Bruno, in Zürich"} />
        </div>
    </div>

    <div class="mt-20 space-y-5 text-lg leading-relaxed">
        {copy.story.map((paragraph, index) => <p data-reveal style={`--delay: ${index * 60}ms`}>{paragraph}</p>)}
    </div>

    <section class="mt-16">
        <SectionHeading title={copy.alsoTitle} />
        <dl class="grid gap-6 sm:grid-cols-3">
            {
                copy.also.map((item) => (
                    <div data-reveal class="rounded-xl bg-surface p-5 transition duration-300 hover:-translate-y-1 hover:shadow-[0_16px_30px_-18px_rgb(21_35_63/0.35)]">
                        <dt class="font-serif text-lg font-semibold">{item.title}</dt>
                        <dd class="mt-2 text-[0.95rem] leading-relaxed text-muted">{item.body}</dd>
                    </div>
                ))
            }
        </dl>
    </section>

    <section class="mt-16">
        <SectionHeading title={copy.workTitle} />
        <ol class="relative ml-2 border-l-2 border-sky pl-7 space-y-10">
            {
                copy.work.map((job) => (
                    <li data-reveal class="relative">
                        <span class="absolute -left-[2.3rem] top-1.5 h-4 w-4 rounded-full border-4 border-bg bg-sun" aria-hidden="true"></span>
                        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                            <h3 class="font-serif text-xl font-semibold">
                                {job.url ? <a href={job.url} class={linkClass}>{job.company}</a> : job.company}
                            </h3>
                            <span class="text-sm text-muted tabular-nums">{job.years} · {job.place}</span>
                        </div>
                        <p class="mt-2 leading-relaxed">{job.body}</p>
                        {job.items && (
                            <ul class="mt-3 space-y-2 text-[0.95rem] leading-relaxed text-muted">
                                {job.items.map((item) => (
                                    <li class="flex gap-3">
                                        <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sky" aria-hidden="true"></span>
                                        <span>{item}</span>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </li>
                ))
            }
        </ol>
    </section>

    <IdeaBox lang={lang} class="mt-20" />

    <section class="mt-16">
        <SectionHeading title={t("about.contact")} />
        <ContactLinks />
    </section>
</Layout>
