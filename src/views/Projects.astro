---
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
import { getProjects } from "../lib/content";
import { site } from "../lib/site";
import { localizePath, otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects();
---

<Layout lang={lang} altPath={localizePath("/proyectos", otherLang(lang))} pageTitle={t("projects.title")}>
    <h1 class="font-serif text-4xl font-semibold tracking-tight">{t("projects.title")}</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted">
        {t("projects.intro")} <a href={site.github} class="underline underline-offset-4 decoration-border hover:text-accent hover:decoration-accent">GitHub</a>.
    </p>
    <div class="mt-12">
        <ProjectList lang={lang} projects={projects} />
    </div>
</Layout>
