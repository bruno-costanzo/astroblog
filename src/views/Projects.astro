---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CaseShowcase from "../components/CaseShowcase.astro";
import ProjectList from "../components/ProjectList.astro";
import IdeaBox from "../components/IdeaBox.astro";
import { getCases, getProjects } from "../lib/content";
import { site } from "../lib/site";
import { alternates, localizePath, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cases = await getCases(lang);
const projects = await getProjects();
---

<Layout lang={lang} alternates={alternates("/proyectos")} pageTitle={t("projects.title")} wide>
    <header data-reveal class="max-w-2xl">
        <h1 class="title-rule font-serif text-5xl sm:text-6xl font-semibold tracking-tight">{t("projects.title")}</h1>
        <p class="mt-6 text-xl leading-relaxed text-muted">{t("projects.intro")}</p>
    </header>

    <section class="mt-20">
        <CaseShowcase cases={cases} lang={lang} />
    </section>

    <section class="mt-20 sm:mt-28">
        <div data-reveal>
            <SectionHeading title={t("projects.side")} />
        </div>
        <ProjectList lang={lang} projects={projects} />
        <p data-reveal class="mt-8 text-sm text-muted">
            {t("projects.more")} <a href={site.github} class="link-grow text-text hover:text-accent">GitHub</a>.
        </p>
    </section>

    <IdeaBox lang={lang} class="mt-20 sm:mt-28" />
</Layout>
