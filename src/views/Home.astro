---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PostList from "../components/PostList.astro";
import CaseShowcase from "../components/CaseShowcase.astro";
import ContributionList from "../components/ContributionList.astro";
import ProjectContact from "../components/ProjectContact.astro";
import Sun from "../components/Sun.astro";
import { getCases, getContributions, getPosts } from "../lib/content";
import { site } from "../lib/site";
import { localizePath, otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getPosts(lang)).slice(0, 3);
const cases = await getCases(lang);
const contributions = (await getContributions()).filter(({ data }) => data.kind === "pr").slice(0, 3);
const copy = {
    es: {
        hello: "Hola, soy Bruno.",
        title: ["Hago software ", "a medida", " para gente que no tiene un equipo de sistemas."],
        story: [
            "Fui periodista hasta 2021. Trabajé en elCanciller y en Noticias Argentinas, y en esos años aprendí a programar. Hoy vivo en Zúrich y trabajo como desarrollador.",
            "Además de mi trabajo, hago sistemas para clientes. A veces son nuevos, y a veces hay que arreglar o reemplazar uno que ya existe. Abajo te muestro cuatro proyectos.",
        ],
        belief: "Creo que un sistema propio no debería ser algo que solo pueden pagar las empresas grandes.",
        quote: "Mejor que decir es hacer, y mejor que prometer es realizar.",
        cases: "Proyectos",
        casesBody: "Dos son de clientes y dos son míos. En cada uno cuento cómo se hacían las cosas antes y qué cambió.",
        howTitle: "Cómo trabajo",
        how: [
            "Empezamos con una charla. Me contás cómo hacés las cosas hoy y qué es lo que más tiempo te lleva.",
            "No me caso con ninguna tecnología. Uso la que mejor le sirva a tu proyecto, y busco que mantenerlo cueste poco por mes.",
            "Si ya tenés un sistema viejo, no hace falta tirarlo. Se puede arreglar, mejorar o cambiar de a poco.",
            "Cada parte tiene tests automáticos. Si un test falla, el cambio no se publica.",
            "Si querés cargar productos, precios o datos vos mismo, te dejo un panel para hacerlo.",
        ],
        closeTitle: "Contame qué querés resolver.",
        closeBody: "Escribime. Te contesto yo.",
        writing: "En el blog escribo sobre cosas que aprendo trabajando. De vez en cuando también mando arreglos a Rails y a otras gems.",
    },
    en: {
        hello: "Hi, I'm Bruno.",
        title: ["I build ", "custom software", " for people who don't have an IT team."],
        story: [
            "I was a journalist until 2021. I worked at elCanciller and Noticias Argentinas, and in those years I learned to program. Today I live in Zürich and work as a developer.",
            "Besides my job, I build systems for clients. Sometimes they are new, and sometimes an existing one needs to be fixed or replaced. Here are four projects.",
        ],
        belief: "I believe your own system shouldn't be something only big companies can pay for.",
        quote: "Better than saying is doing, and better than promising is achieving.",
        cases: "Projects",
        casesBody: "Two are for clients and two are mine. For each one I explain how things worked before and what changed.",
        howTitle: "How I work",
        how: [
            "We start with a call. You tell me how you do things today and what takes up most of your time.",
            "I'm not tied to any technology. I use whatever works best for your project, and I aim to keep it cheap to run each month.",
            "If you already have an old system, you don't have to throw it away. It can be fixed, improved or replaced step by step.",
            "Every part has automated tests. If a test fails, the change does not ship.",
            "If you want to manage products, prices or data yourself, you get a panel for it.",
        ],
        closeTitle: "Tell me what you want to solve.",
        closeBody: "Write to me. I answer myself.",
        writing: "On the blog I write about things I learn at work. Now and then I also send fixes to Rails and other gems.",
    },
}[lang];
---

<Layout lang={lang} altPath={localizePath("/", otherLang(lang))} wide>
    <section class="grid items-center gap-10 lg:grid-cols-[1.6fr_1fr] lg:gap-16 lg:pt-4">
        <div>
        <div class="flex items-center gap-4">
            <img src={site.photo} alt={site.name} width="64" height="64" class="lg:hidden w-16 h-16 rounded-full object-cover border border-border" />
            <p class="font-hand text-3xl sm:text-4xl italic">{copy.hello}</p>
        </div>
        <h1 class="mt-8 font-serif text-[2.4rem] sm:text-[3.4rem] font-semibold tracking-tight leading-[1.04] text-balance">{copy.title[0]}<span class="mark">{copy.title[1]}</span>{copy.title[2]}</h1>
        <div class="mt-8 space-y-4 text-lg sm:text-xl leading-relaxed">
            {copy.story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <p class="mt-6 border-l-4 border-sun pl-4 font-hand text-2xl sm:text-[1.7rem] italic leading-snug text-accent">{copy.belief}</p>
        <div class="mt-8">
            <ProjectContact lang={lang} />
        </div>
        </div>
        <div class="relative mx-auto hidden w-full max-w-[15rem] lg:block xl:max-w-xs" aria-hidden="true">
            <Sun class="absolute -inset-[25%] w-[150%] h-[150%] max-w-none text-sun xl:-inset-[42%] xl:w-[184%] xl:h-[184%]" spin />
            <img src={site.photo} alt="" width="400" height="400" class="escarapela relative aspect-square w-full rounded-full object-cover" />
        </div>
    </section>

    <section class="mt-28 sm:mt-36">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border pb-6">
            <div class="max-w-2xl">
                <figure class="mb-10">
                    <blockquote class="font-hand text-2xl sm:text-3xl italic leading-snug">«{copy.quote}»</blockquote>
                    <figcaption class="mt-2 text-sm text-muted">Juan Domingo Perón</figcaption>
                </figure>
                <h2 class="font-serif text-4xl font-semibold tracking-tight">{copy.cases}</h2>
                <p class="mt-3 text-lg leading-relaxed text-muted">{copy.casesBody}</p>
            </div>
            <a href={localizePath("/proyectos", lang)} class="text-sm text-muted hover:text-accent transition-colors">{t("home.all")} →</a>
        </div>
        <div class="mt-14">
            <CaseShowcase cases={cases} lang={lang} />
        </div>
    </section>

    <section class="mt-28 sm:mt-36 grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
        <div>
            <h2 class="font-serif text-4xl font-semibold tracking-tight">{copy.howTitle}</h2>
        </div>
        <ol class="space-y-6">
            {
                copy.how.map((paragraph, index) => (
                    <li class="flex gap-5">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-sky-soft font-serif text-base font-semibold text-accent" aria-hidden="true">{index + 1}</span>
                        <p class="pt-1 text-lg leading-relaxed">{paragraph}</p>
                    </li>
                ))
            }
        </ol>
    </section>

    <section class="relative mt-28 sm:mt-36 overflow-hidden rounded-2xl bg-gradient-to-b from-sky-soft to-sky px-6 pt-12 pb-40 sm:px-14 sm:py-16">
        <Sun class="pointer-events-none absolute -bottom-44 -right-32 w-80 h-80 text-sun sm:-bottom-48 sm:right-10 sm:w-[28rem] sm:h-[28rem]" spin />
        <h2 class="relative max-w-xl font-serif text-4xl sm:text-5xl font-semibold tracking-tight text-balance">{copy.closeTitle}</h2>
        <p class="relative mt-4 text-lg leading-relaxed">{copy.closeBody}</p>
        <div class="relative z-10 mt-8">
            <ProjectContact lang={lang} />
        </div>
    </section>

    <p class="mt-28 max-w-2xl font-hand text-[1.7rem] italic leading-snug">{copy.writing}</p>
    <div class="mt-10 grid gap-16 lg:grid-cols-2 lg:gap-14">
        {
            posts.length > 0 && (
                <section>
                    <SectionHeading title={t("home.posts")} href={localizePath("/blog", lang)} linkLabel={t("home.all")} />
                    <PostList lang={lang} posts={posts} />
                </section>
            )
        }
        <section>
            <SectionHeading title={t("home.opensource")} href={localizePath("/open-source", lang)} linkLabel={t("home.all")} />
            <ContributionList lang={lang} contributions={contributions} showRepo />
        </section>
    </div>
</Layout>
