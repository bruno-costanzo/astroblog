---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PostList from "../components/PostList.astro";
import CaseShowcase from "../components/CaseShowcase.astro";
import DeviceShot from "../components/DeviceShot.astro";
import heroDesktop from "../assets/cases/lacaniosa/gestion-desktop.webp";
import heroMobile from "../assets/cases/lacaniosa/paciente-mobile.webp";
import ContributionList from "../components/ContributionList.astro";
import ProjectContact from "../components/ProjectContact.astro";
import { getCases, getContributions, getPosts } from "../lib/content";
import { site } from "../lib/site";
import { localizePath, otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getPosts(lang)).slice(0, 3);
const cases = await getCases(lang);
const contributions = (await getContributions()).filter(({ data }) => data.kind === "pr").slice(0, 3);
const copy = {
    es: {
        kicker: "Bruno Costanzo · software a medida",
        title: "Tu sistema a medida, que funcione y a un precio justo.",
        body: "Construyo software para negocios, profesionales y comunidades que hoy se arreglan con planillas, cuadernos y mensajes de WhatsApp.",
        belief: "Tener un sistema propio no tiene que ser un lujo de las empresas grandes.",
        heroAlt: "Resumen del mes de Lacaniosa en la computadora y la ficha de un paciente en el teléfono",
        cases: "Lo que construí",
        casesBody: "Dos sistemas para clientes y dos productos propios. Cada uno empezó con una forma de trabajar que ya no alcanzaba.",
        howTitle: "Cómo trabajo",
        how: [
            "Primero quiero entender cómo trabajás hoy, con tus planillas, tus cuadernos y tus chats. El sistema se arma alrededor de eso. Si vendés por WhatsApp, el sistema vende por WhatsApp.",
            "Puede ser un sistema de gestión, una tienda, una app para el teléfono o una parte con inteligencia artificial. Uso Ruby on Rails y SQLite en un solo servidor, así mantenerlo cuesta poco cada mes.",
            "Cada función tiene tests automáticos, y nada se publica si los tests fallan. Cuando hace falta, te queda un panel para cargar productos, precios o datos sin depender de mí.",
        ],
        me: "Soy desarrollador Ruby on Rails. Vivo en Zúrich y trabajo en español y en inglés.",
        closeTitle: "¿Qué hacés hoy a mano?",
        closeBody: "Contámelo y vemos juntos si un sistema lo resuelve.",
    },
    en: {
        kicker: "Bruno Costanzo · custom software",
        title: "Custom software that works, at a fair price.",
        body: "I build software for businesses, professionals and communities that today get by with spreadsheets, notebooks and WhatsApp messages.",
        belief: "Having your own system should not be a luxury for big companies.",
        heroAlt: "Lacaniosa's month summary on a computer and a patient's file on a phone",
        cases: "What I built",
        casesBody: "Two systems for clients and two products of my own. Each one started with a way of working that no longer did the job.",
        howTitle: "How I work",
        how: [
            "First I want to understand how you work today, with your spreadsheets, notebooks and chats. The system is built around that. If you sell on WhatsApp, the system sells on WhatsApp.",
            "It can be a management system, a shop, a phone app or a part that uses AI. I use Ruby on Rails and SQLite on a single server, so it costs little to run each month.",
            "Every feature has automated tests, and nothing ships if the tests fail. When it makes sense, you get an admin panel to manage products, prices or data without me.",
        ],
        me: "I'm a Ruby on Rails developer. I live in Zürich and work in Spanish and English.",
        closeTitle: "What do you still do by hand?",
        closeBody: "Tell me, and we'll see together whether a system can solve it.",
    },
}[lang];
---

<Layout lang={lang} altPath={localizePath("/", otherLang(lang))} wide>
    <section class="grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:pt-6">
        <div>
            <p class="text-sm text-muted">{copy.kicker}</p>
            <h1 class="mt-4 font-serif text-[2.6rem] sm:text-6xl font-semibold tracking-tight leading-[1.04] text-balance">{copy.title}</h1>
            <p class="mt-6 max-w-xl text-lg sm:text-xl leading-relaxed">{copy.body}</p>
            <p class="mt-5 max-w-xl font-serif text-xl italic leading-relaxed text-accent">{copy.belief}</p>
            <div class="mt-8">
                <ProjectContact lang={lang} />
            </div>
        </div>
        <DeviceShot desktop={heroDesktop} mobile={heroMobile} alt={copy.heroAlt} host="lacaniosa.com" eager />
    </section>

    <section class="mt-28 sm:mt-36">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border pb-6">
            <div class="max-w-2xl">
                <h2 class="font-serif text-4xl font-semibold tracking-tight">{copy.cases}</h2>
                <p class="mt-3 text-lg leading-relaxed text-muted">{copy.casesBody}</p>
            </div>
            <a href={localizePath("/proyectos", lang)} class="text-sm text-muted hover:text-accent transition-colors">{t("home.all")} →</a>
        </div>
        <div class="mt-14">
            <CaseShowcase cases={cases} lang={lang} />
        </div>
    </section>

    <section class="mt-28 sm:mt-36 grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
        <div>
            <h2 class="font-serif text-4xl font-semibold tracking-tight">{copy.howTitle}</h2>
            <div class="mt-6 flex items-center gap-4">
                <img src={site.photo} alt={site.name} width="64" height="64" class="w-16 h-16 rounded-full object-cover border border-border" />
                <p class="text-[0.95rem] leading-relaxed text-muted">{copy.me}</p>
            </div>
        </div>
        <div class="space-y-5 font-serif text-xl leading-relaxed">
            {copy.how.map((paragraph) => <p>{paragraph}</p>)}
        </div>
    </section>

    <section class="mt-28 sm:mt-36 rounded-xl bg-surface px-6 py-12 sm:px-14 sm:py-16">
        <h2 class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight text-balance">{copy.closeTitle}</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">{copy.closeBody}</p>
        <div class="mt-8">
            <ProjectContact lang={lang} />
        </div>
    </section>

    <div class="mt-28 grid gap-16 lg:grid-cols-2 lg:gap-14">
        {
            posts.length > 0 && (
                <section>
                    <SectionHeading title={t("home.posts")} href={localizePath("/blog", lang)} linkLabel={t("home.all")} />
                    <PostList lang={lang} posts={posts} />
                </section>
            )
        }
        <section>
            <SectionHeading title={t("home.opensource")} href={localizePath("/open-source", lang)} linkLabel={t("home.all")} />
            <ContributionList lang={lang} contributions={contributions} showRepo />
        </section>
    </div>
</Layout>
