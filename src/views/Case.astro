---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { caseLang, caseSlug } from "../lib/content";
import { localizePath, otherLang, useTranslations } from "../i18n";

interface Props {
    entry: CollectionEntry<"cases">;
}

const { entry } = Astro.props;
const { data } = entry;
const lang = caseLang(entry);
const t = useTranslations(lang);
const { Content } = await render(entry);

const poster = (src: string) => src.replace(/\.mp4$/, "-poster.jpg");
const host = data.url ? new URL(data.url).hostname.replace("www.", "") : undefined;
const altPath = localizePath(`/proyectos/${caseSlug(entry)}/`, otherLang(lang));
---

<Layout lang={lang} altPath={altPath} pageTitle={data.name} description={data.summary} type="article">
    <a href={localizePath("/proyectos", lang)} class="text-sm text-muted hover:text-accent transition-colors">
        {t("case.back")}
    </a>

    <header class="mt-6">
        <h1 class="font-serif text-4xl sm:text-[2.75rem] font-semibold tracking-tight leading-tight">{data.name}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{data.summary}</p>

        <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-4 border-y border-border py-5 text-sm">
            <div>
                <dt class="text-muted">{t("case.client")}</dt>
                <dd class="mt-1">{data.client}</dd>
            </div>
            <div>
                <dt class="text-muted">{t("case.year")}</dt>
                <dd class="mt-1 tabular-nums">{data.year}</dd>
            </div>
            <div>
                <dt class="text-muted">{t("case.role")}</dt>
                <dd class="mt-1">{data.role}</dd>
            </div>
            <div>
                <dt class="text-muted">{t("case.stack")}</dt>
                <dd class="mt-1">{data.stack.join(", ")}</dd>
            </div>
        </dl>
        {host && (
            <p class="mt-3 text-sm text-muted">
                <a href={data.url} class="hover:text-accent transition-colors">{host}</a>
            </p>
        )}
    </header>

    <section class="mt-12" aria-labelledby="demo">
        <h2 id="demo" class="sr-only">{t("case.demo")}</h2>
        <div class:list={["bleed grid gap-4 items-start", data.video.mobile && "sm:grid-cols-[3fr_1fr]"]}>
            <video
                src={data.video.desktop}
                poster={poster(data.video.desktop)}
                width="1280"
                height="800"
                controls
                muted
                playsinline
                preload="none"
                aria-label={`${data.video.label} (${t("case.desktop")})`}
                class:list={["w-full h-auto rounded-md border border-border bg-surface", data.video.mobile && "hidden sm:block"]}
            ></video>
            {data.video.mobile && (
                <video
                    src={data.video.mobile}
                    poster={poster(data.video.mobile)}
                    width="390"
                    height="844"
                    controls
                    muted
                    playsinline
                    preload="none"
                    aria-label={`${data.video.label} (${t("case.mobile")})`}
                    class="w-full max-w-64 mx-auto sm:max-w-none h-auto rounded-xl border border-border bg-surface"
                ></video>
            )}
        </div>
        <p class="mt-3 text-sm text-muted">{data.video.label}</p>
    </section>

    <div class="mt-14 prose prose-lg max-w-none">
        <Content />
    </div>

    <section class="mt-16">
        <SectionHeading title={t("case.features")} />
        <ol class="space-y-16">
            {
                data.features.map((feature) => (
                    <li>
                        <h3 class="font-serif text-2xl font-semibold tracking-tight">{feature.title}</h3>
                        <p class="mt-3 text-lg leading-relaxed">{feature.body}</p>
                        <div class:list={["bleed mt-6 grid gap-4 items-start", feature.desktop && feature.mobile && "sm:grid-cols-[3fr_1fr]"]}>
                            {feature.desktop && (
                                <Image
                                    src={feature.desktop}
                                    alt={`${feature.alt} (${t("case.desktop")})`}
                                    widths={[800, 1600, 2400]}
                                    sizes="(min-width: 640px) 51rem, 100vw"
                                    class="w-full h-auto rounded-md border border-border"
                                />
                            )}
                            {feature.mobile && (
                                <Image
                                    src={feature.mobile}
                                    alt={`${feature.alt} (${t("case.mobile")})`}
                                    widths={[320, 640]}
                                    sizes="(min-width: 640px) 17rem, 16rem"
                                    class="w-full max-w-64 mx-auto sm:max-w-none h-auto rounded-xl border border-border"
                                />
                            )}
                        </div>
                    </li>
                ))
            }
        </ol>
    </section>
</Layout>
