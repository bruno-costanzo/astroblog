---
import Layout from "../layouts/Layout.astro";
import ContributionList from "../components/ContributionList.astro";
import { getContributions, groupBy } from "../lib/content";
import { localizePath, otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contributions = await getContributions();
const repos = groupBy(contributions, (contribution) => contribution.data.repo);
const merged = contributions.filter((contribution) => contribution.data.status === "merged");
const mergedRepos = new Set(merged.map((contribution) => contribution.data.repo)).size;

const intro = {
    es: `${merged.length} pull requests mergeados en ${mergedRepos} repositorios.`,
    en: `${merged.length} merged pull requests in ${mergedRepos} repositories.`,
}[lang];
---

<Layout lang={lang} altPath={localizePath("/open-source", otherLang(lang))} pageTitle={t("opensource.title")}>
    <h1 class="font-serif text-4xl font-semibold tracking-tight">{t("opensource.title")}</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted">{intro}</p>

    {
        [...repos].map(([repo, repoContributions]) => (
            <section class="mt-12">
                <h2 class="mb-3 font-mono text-sm">
                    <a href={`https://github.com/${repo}`} class="hover:text-accent transition-colors">{repo}</a>
                </h2>
                <ContributionList lang={lang} contributions={repoContributions} />
            </section>
        ))
    }
</Layout>
