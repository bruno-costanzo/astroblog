---
import Layout from "../layouts/Layout.astro";
import ContributionList from "../components/ContributionList.astro";
import { getContributions, groupBy } from "../lib/content";
import { alternates, localizePath, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contributions = await getContributions();
const repos = groupBy(contributions, (contribution) => contribution.data.repo);
const merged = contributions.filter((contribution) => contribution.data.status === "merged");
const issues = contributions.filter((contribution) => contribution.data.kind === "issue").length;
const mergedRepos = new Set(merged.map((contribution) => contribution.data.repo)).size;

const intro = {
    es: `${merged.length} pull requests mergeados en ${mergedRepos} repositorios y ${issues} issues reportados.`,
    en: `${merged.length} merged pull requests in ${mergedRepos} repositories and ${issues} reported issues.`,
    it: `${merged.length} pull request integrate in ${mergedRepos} repository e ${issues} issue segnalate.`,
}[lang];
---

<Layout lang={lang} alternates={alternates("/open-source")} pageTitle={t("opensource.title")}>
    <h1 data-reveal class="title-rule font-serif text-5xl font-semibold tracking-tight">{t("opensource.title")}</h1>
    <p data-reveal style="--delay: 80ms" class="mt-6 text-lg leading-relaxed text-muted">{intro}</p>

    {
        [...repos].map(([repo, repoContributions]) => (
            <section data-reveal class="mt-12">
                <h2 class="mb-3 font-mono text-sm">
                    <a href={`https://github.com/${repo}`} class="hover:text-accent transition-colors">{repo}</a>
                </h2>
                <ContributionList lang={lang} contributions={repoContributions} />
            </section>
        ))
    }
</Layout>
