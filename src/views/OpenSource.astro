---
import Layout from "../layouts/Layout.astro";
import ContributionList from "../components/ContributionList.astro";
import { getContributions, groupBy } from "../lib/content";
import { alternates, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type Contribution = Awaited<ReturnType<typeof getContributions>>[number];
const isMerged = ({ data }: Contribution) => data.kind === "pr" && data.status === "merged";
const isInReview = ({ data }: Contribution) => data.kind === "pr" && data.status === "open";
const isIssue = ({ data }: Contribution) => data.kind === "issue";

const contributions = await getContributions();
const merged = contributions.filter(isMerged);
const issues = contributions.filter(isIssue);
const mergedRepos = new Set(merged.map(({ data }) => data.repo)).size;

// Repos with more merged work first.
const repos = [...groupBy(contributions, ({ data }) => data.repo)]
    .map(([repo, items]) => ({
        repo,
        owner: repo.split("/")[0],
        items,
        merged: items.filter(isMerged).length,
        inReview: items.filter(isInReview).length,
        issues: items.filter(isIssue).length,
    }))
    .sort((a, b) => b.merged - a.merged || b.items.length - a.items.length || a.repo.localeCompare(b.repo));

const intro = {
    es: `${merged.length} pull requests mergeados en ${mergedRepos} repositorios y ${issues.length} issues reportados.`,
    en: `${merged.length} merged pull requests in ${mergedRepos} repositories and ${issues.length} reported issues.`,
    it: `${merged.length} pull request integrate in ${mergedRepos} repository e ${issues.length} issue segnalate.`,
}[lang];

const stats = [
    [merged.length, t("opensource.statMerged")],
    [contributions.filter(isInReview).length, t("opensource.statOpen")],
    [issues.length, t("opensource.statIssues")],
    [repos.length, t("opensource.statRepos")],
] as const;
---

<Layout lang={lang} alternates={alternates("/open-source")} pageTitle={t("opensource.title")}>
    <h1 data-reveal class="title-rule font-serif text-5xl font-semibold tracking-tight">{t("opensource.title")}</h1>
    <p data-reveal style="--delay: 80ms" class="mt-6 text-lg leading-relaxed text-muted">{intro}</p>

    <dl data-reveal style="--delay: 120ms" class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3">
        {
            stats.map(([value, label]) => (
                <div class="flex flex-col rounded-lg border border-border bg-surface/60 px-4 py-3">
                    <dt class="text-sm text-muted">{label}</dt>
                    <dd class="order-first font-serif text-3xl font-semibold tabular-nums">{value}</dd>
                </div>
            ))
        }
    </dl>

    <div class="mt-12 grid items-start gap-4 sm:grid-cols-2">
        {
            repos.map(({ repo, owner, items, merged, inReview, issues }, index) => (
                <article data-reveal style={`--delay: ${Math.min(index, 5) * 50}ms`} class="rounded-xl border border-border bg-surface/40 p-5">
                    <a href={`https://github.com/${repo}`} class="group flex items-center gap-3">
                        <img
                            src={`https://github.com/${owner}.png?size=80`}
                            alt=""
                            width="40"
                            height="40"
                            loading="lazy"
                            class="h-10 w-10 shrink-0 rounded-lg border border-border bg-bg"
                        />
                        <span class="min-w-0 font-mono text-sm leading-tight [overflow-wrap:anywhere]">
                            <span class="text-muted">{owner}/</span>
                            <span class="font-medium group-hover:text-accent transition-colors">{repo.slice(owner.length + 1)}</span>
                        </span>
                    </a>

                    <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted">
                        {merged > 0 && (
                            <span>
                                <strong class="text-text tabular-nums">{merged}</strong> {t(merged === 1 ? "opensource.countMergedOne" : "opensource.countMerged")}
                            </span>
                        )}
                        {inReview > 0 && (
                            <span>
                                <strong class="text-text tabular-nums">{inReview}</strong> {t("opensource.countOpen")}
                            </span>
                        )}
                        {issues > 0 && (
                            <span>
                                <strong class="text-text tabular-nums">{issues}</strong> {t(issues === 1 ? "opensource.countIssuesOne" : "opensource.countIssues")}
                            </span>
                        )}
                    </p>

                    <details class="group/details mt-4 border-t border-border pt-3">
                        <summary class="flex cursor-pointer list-none items-center justify-between text-sm text-accent [&::-webkit-details-marker]:hidden">
                            {t("opensource.toggle")}
                            <span aria-hidden="true" class="transition-transform group-open/details:rotate-180">▾</span>
                        </summary>
                        <div class="mt-3">
                            <ContributionList lang={lang} contributions={items} compact />
                        </div>
                    </details>
                </article>
            ))
        }
    </div>
</Layout>
