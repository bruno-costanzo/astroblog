---
import { Icon } from "astro-icon/components";
import { site } from "../lib/site";

const links = [
    { href: `mailto:${site.email}`, icon: "lucide:mail", label: "Email", primary: true },
    { href: site.github, icon: "lucide:github", label: "GitHub" },
    { href: site.linkedin, icon: "lucide:linkedin", label: "LinkedIn" },
];
---

<div class="flex flex-wrap items-center gap-3 text-sm">
    {
        links.map((link) => (
            <a
                href={link.href}
                class:list={[
                    "inline-flex items-center gap-2 rounded-full px-4 py-2 transition",
                    link.primary
                        ? "bg-text text-bg font-medium hover:opacity-85"
                        : "border border-border hover:border-text",
                ]}
            >
                <Icon name={link.icon} class="w-4 h-4" /> {link.label}
            </a>
        ))
    }
</div>
