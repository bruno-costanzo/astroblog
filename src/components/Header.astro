---
import { Icon } from "astro-icon/components";
import { site } from "../lib/site";
import { localizePath, otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
    altPath?: string;
}

const { lang, altPath } = Astro.props;
const t = useTranslations(lang);

const links = [
    { href: localizePath("/blog", lang), label: t("nav.blog") },
    { href: localizePath("/proyectos", lang), label: t("nav.projects") },
    { href: localizePath("/open-source", lang), label: t("nav.opensource") },
    { href: localizePath("/sobre-mi", lang), label: t("nav.about") },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const switchHref = altPath ?? localizePath("/", otherLang(lang));
---

<header class="border-b border-border">
    <!-- Mobile: name + controls on the first row, links on the second. Desktop: one row. -->
    <div class="max-w-3xl mx-auto px-5 sm:px-6 py-4 sm:py-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href={localizePath("/", lang)} class="font-serif text-xl font-semibold tracking-tight hover:text-accent transition-colors">
            {site.name}
        </a>
        <nav class="order-last sm:order-none w-full sm:w-auto sm:ml-auto flex items-center justify-between sm:justify-start gap-3 sm:gap-5 text-sm whitespace-nowrap">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class:list={[
                            "transition-colors hover:text-text",
                            isActive(link.href) ? "text-text font-medium" : "text-muted",
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
        <div class="ml-auto sm:ml-0 flex items-center gap-4">
            <a href={switchHref} hreflang={otherLang(lang)} lang={otherLang(lang)} title={t("nav.switch")} class="font-mono text-xs uppercase text-muted hover:text-text transition-colors">
                {otherLang(lang)}
            </a>
            <button
                id="theme-toggle"
                type="button"
                aria-label={t("nav.theme")}
                class="text-muted hover:text-text transition-colors cursor-pointer"
            >
                <Icon name="lucide:moon" class="w-4 h-4 dark-hidden" />
                <Icon name="lucide:sun" class="w-4 h-4 light-hidden" />
            </button>
        </div>
    </div>
</header>

<style>
    :global([data-theme="dark"]) .dark-hidden,
    :global([data-theme="light"]) .light-hidden {
        display: none;
    }
</style>

<script>
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
    });
</script>
