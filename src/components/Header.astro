---
import { Icon } from "astro-icon/components";
import { site } from "../lib/site";

const links = [
    { href: "/blog", label: "Blog" },
    { href: "/proyectos", label: "Proyectos" },
    { href: "/open-source", label: "Open Source" },
    { href: "/sobre-mi", label: "Sobre mí" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-b border-border">
    <div class="max-w-2xl mx-auto px-5 sm:px-6 py-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <a href="/" class="font-serif text-xl font-semibold tracking-tight hover:text-accent transition-colors">
            {site.name}
        </a>
        <nav class="flex items-center gap-5 text-sm">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class:list={[
                            "transition-colors hover:text-text",
                            isActive(link.href) ? "text-text font-medium" : "text-muted",
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }
            <button
                id="theme-toggle"
                type="button"
                aria-label="Cambiar tema"
                class="text-muted hover:text-text transition-colors cursor-pointer"
            >
                <Icon name="lucide:moon" class="w-4 h-4 dark-hidden" />
                <Icon name="lucide:sun" class="w-4 h-4 light-hidden" />
            </button>
        </nav>
    </div>
</header>

<style>
    :global([data-theme="dark"]) .dark-hidden,
    :global([data-theme="light"]) .light-hidden {
        display: none;
    }
</style>

<script>
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
    });
</script>
