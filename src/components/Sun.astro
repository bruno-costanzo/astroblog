---
// Sol de Mayo: 32 rays, straight and wavy one after the other, around a disc.
interface Props {
    class?: string;
    spin?: boolean;
}

const { class: className, spin = false } = Astro.props;

const rays = Array.from({ length: 32 }, (_, i) => ({ angle: (i * 360) / 32, wavy: i % 2 === 1 }));
const straight = "M0 -27 L2.4 -46 L0 -54 L-2.4 -46 Z";
const wavy = "M0 -27 C 3.5 -31, -3.5 -35, 0 -39 S 3.5 -47, 0 -51";
---

<svg viewBox="-56 -56 112 112" class:list={[className, spin && "sun-spin"]} aria-hidden="true">
    <g fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        {
            rays.map(({ angle, wavy: isWavy }) =>
                isWavy ? (
                    <path d={wavy} fill="none" stroke-width="2.4" transform={`rotate(${angle})`} />
                ) : (
                    <path d={straight} stroke-width="0.6" transform={`rotate(${angle})`} />
                ),
            )
        }
        <circle r="22" />
        <circle r="22" fill="none" stroke="var(--bg)" stroke-opacity="0.35" stroke-width="1.2" />
        <circle r="17" fill="none" stroke="var(--bg)" stroke-opacity="0.25" stroke-width="0.8" />
    </g>
</svg>
