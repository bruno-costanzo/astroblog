---
// Sol de Mayo: 32 rays, straight and wavy one after the other, around a disc.
interface Props {
    class?: string;
}

const { class: className } = Astro.props;

const rays = Array.from({ length: 32 }, (_, i) => ({ angle: (i * 360) / 32, wavy: i % 2 === 1 }));
const straight = "M0 -26 L1.6 -44 L0 -50 L-1.6 -44 Z";
const wavy = "M0 -26 C 2.6 -29.5, -2.6 -33, 0 -36.5 S 2.6 -43.5, 0 -47";
---

<svg viewBox="-52 -52 104 104" class={className} aria-hidden="true">
    <g fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        {
            rays.map(({ angle, wavy: isWavy }) =>
                isWavy ? (
                    <path d={wavy} fill="none" stroke-width="1.5" transform={`rotate(${angle})`} />
                ) : (
                    <path d={straight} stroke-width="0.4" transform={`rotate(${angle})`} />
                ),
            )
        }
        <circle r="21" />
        <circle r="17" fill="none" stroke="var(--bg)" stroke-opacity="0.3" stroke-width="0.8" />
    </g>
</svg>
