---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// A desktop screenshot in a browser window, with a phone screenshot over its corner.
interface Props {
    desktop: ImageMetadata;
    mobile?: ImageMetadata;
    alt: string;
    host?: string;
    eager?: boolean;
}

const { desktop, mobile, alt, host, eager = false } = Astro.props;
const loading = eager ? "eager" : "lazy";
---

<div class:list={["relative", mobile && "pb-8 pr-6 sm:pr-10"]}>
    <div class="overflow-hidden rounded-lg border border-border bg-bg shadow-[0_24px_60px_-30px_rgb(0_0_0/0.35)]">
        <div class="flex items-center gap-1.5 border-b border-border bg-surface px-3 py-2">
            <span class="h-2 w-2 rounded-full bg-border"></span>
            <span class="h-2 w-2 rounded-full bg-border"></span>
            <span class="h-2 w-2 rounded-full bg-border"></span>
            {host && <span class="ml-3 truncate font-mono text-[0.7rem] text-muted">{host}</span>}
        </div>
        <Image
            src={desktop}
            alt={alt}
            widths={[640, 1040, 1600]}
            sizes="(min-width: 1024px) 40rem, 100vw"
            loading={loading}
            class="block w-full aspect-[16/10] object-cover object-top"
        />
    </div>
    {
        mobile && (
            <div class="absolute bottom-0 right-0 w-[26%] min-w-24 overflow-hidden rounded-[1.1rem] border-[5px] border-[#1c1b19] bg-[#1c1b19] shadow-[0_18px_40px_-16px_rgb(0_0_0/0.5)]">
                <Image
                    src={mobile}
                    alt=""
                    widths={[200, 400]}
                    sizes="12rem"
                    loading={loading}
                    class="block w-full aspect-[9/19] object-cover object-top rounded-[0.8rem]"
                />
            </div>
        )
    }
</div>
