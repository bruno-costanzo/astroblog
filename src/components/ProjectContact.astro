---
import { Icon } from "astro-icon/components";
import { site } from "../lib/site";
import type { Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const copy = {
    es: {
        email: "Escribime un email",
        subject: "Quiero un sistema a medida",
        whatsapp: "WhatsApp",
        message: "Hola Bruno, quiero contarte una idea para un sistema.",
        calendar: "Agendá una llamada",
    },
    en: {
        email: "Send me an email",
        subject: "I want custom software",
        whatsapp: "WhatsApp",
        message: "Hi Bruno, I'd like to tell you about an idea for a system.",
        calendar: "Book a call",
    },
    it: {
        email: "Scrivimi una email",
        subject: "Vorrei un sistema su misura",
        whatsapp: "WhatsApp",
        message: "Ciao Bruno, vorrei raccontarti un'idea per un sistema.",
        calendar: "Prenota una chiamata",
    },
}[lang];

const links = [
    { href: `mailto:${site.email}?subject=${encodeURIComponent(copy.subject)}`, icon: "lucide:mail", label: copy.email, event: "contact-email", primary: true },
    site.whatsapp && { href: `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(copy.message)}`, icon: "lucide:message-circle", label: copy.whatsapp, event: "contact-whatsapp" },
    site.calendar && { href: site.calendar, icon: "lucide:calendar", label: copy.calendar, event: "contact-calendly" },
].filter(Boolean) as { href: string; icon: string; label: string; event: string; primary?: boolean }[];
---

<div class="flex flex-wrap items-center gap-3 text-sm">
    {
        links.map((link) => (
            <a
                href={link.href}
                data-umami-event={link.event}
                class:list={[
                    "inline-flex items-center gap-2 rounded-full px-4 py-2 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
                    link.primary ? "bg-accent text-bg font-medium hover:opacity-90" : "border border-border hover:border-text",
                ]}
            >
                <Icon name={link.icon} class="w-4 h-4" aria-hidden="true" /> {link.label}
            </a>
        ))
    }
</div>
