---
interface Props {
    title: string;
    href?: string;
    linkLabel?: string;
}

const { title, href, linkLabel = "Ver todo" } = Astro.props;
---

<div class="flex items-baseline justify-between gap-4 mb-6">
    <h2 class="text-xs font-medium uppercase tracking-[0.14em] text-muted">{title}</h2>
    {
        href && (
            <a href={href} class="text-sm text-muted hover:text-accent transition-colors">
                {linkLabel} →
            </a>
        )
    }
</div>
