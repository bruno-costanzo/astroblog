---
interface Props {
    title: string;
    href?: string;
    linkLabel?: string;
}

const { title, href, linkLabel = "Ver todo" } = Astro.props;
---

<div class="flex items-center justify-between gap-4 mb-6">
    <h2 class="inline-flex items-center rounded-full bg-sky-soft px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-accent">{title}</h2>
    {
        href && (
            <a href={href} class="text-sm text-muted hover:text-accent transition-colors">
                {linkLabel} →
            </a>
        )
    }
</div>
