---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/content";
import { useTranslations, type Lang } from "../i18n";

interface Props {
    lang: Lang;
    contributions: CollectionEntry<"opensource">[];
    showRepo?: boolean;
}

const { lang, contributions, showRepo = false } = Astro.props;
const t = useTranslations(lang);

const statusLabel = {
    merged: t("opensource.merged"),
    fixed: t("opensource.fixed"),
    open: t("opensource.open"),
};
const label = (data: CollectionEntry<"opensource">["data"]) =>
    data.kind === "issue" && data.status === "open" ? t("opensource.issueOpen") : statusLabel[data.status];
---

<ul class="divide-y divide-border border-y border-border">
    {
        contributions.map(({ data }, index) => (
            <li data-reveal style={`--delay: ${Math.min(index, 4) * 50}ms`}>
                <a href={data.url} class="group grid sm:grid-cols-[1fr_auto] gap-x-6 gap-y-1 py-4 -mx-3 px-3 rounded-lg transition-colors hover:bg-sky-soft/50">
                    <div class="min-w-0">
                        {showRepo && <span class="font-mono text-xs text-muted">{data.repo}</span>}
                        <p class="leading-snug [overflow-wrap:anywhere] group-hover:text-accent transition-colors">
                            {data.kind === "issue" && (
                                <span class="mr-1.5 font-mono text-xs uppercase tracking-wide text-muted">{t("opensource.issue")}</span>
                            )}
                            {data.title.split("::").map((part, i) => (i === 0 ? part : <>::<wbr />{part}</>))}
                        </p>
                    </div>
                    <div class="flex items-center gap-3 text-sm text-muted sm:justify-end">
                        <span
                            class:list={[
                                "rounded-full border px-2 py-0.5 text-xs",
                                data.status === "open" ? "border-border" : "border-accent/40 text-accent",
                            ]}
                        >
                            {label(data)}
                        </span>
                        <time datetime={data.date.toISOString()} class="tabular-nums whitespace-nowrap">
                            {formatDate(data.date, lang)}
                        </time>
                    </div>
                </a>
            </li>
        ))
    }
</ul>
