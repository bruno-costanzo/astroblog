---
import type { CollectionEntry } from "astro:content";
import { formatDate, postUrl } from "../lib/content";
import type { Lang } from "../i18n";

interface Props {
    lang: Lang;
    posts: CollectionEntry<"blog">[];
}

const { lang, posts } = Astro.props;
---

<ul class="divide-y divide-border border-y border-border">
    {
        posts.map((post) => (
            <li>
                <a href={postUrl(post)} class="group grid sm:grid-cols-[7rem_1fr] gap-x-6 gap-y-1 py-5">
                    <time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted tabular-nums sm:pt-1">
                        {formatDate(post.data.pubDate, lang)}
                    </time>
                    <div>
                        <h3 class="font-serif text-xl font-medium leading-snug group-hover:text-accent transition-colors">
                            {post.data.title}
                        </h3>
                        <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{post.data.description}</p>
                    </div>
                </a>
            </li>
        ))
    }
</ul>
